generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Provincia {
  id            Int     @id @default(autoincrement()) @map("id_provincia")
  codigoDpa     String  @unique(map: "provincia_codigo_dpa_key") @map("codigo_dpa") @db.VarChar(10)
  nombre        String  @unique(map: "provincia_nombre_key") @db.VarChar(100)
  descripcion   String? @db.Text
  imagenPortada String? @map("imagen_portada") @db.VarChar(2048)
  estado        Boolean @default(true)

  cantones Canton[]

  @@map("provincia")
}

model Canton {
  id                 Int       @id @default(autoincrement()) @map("id_canton")
  codigoDpa          String    @unique(map: "canton_codigo_dpa_key") @map("codigo_dpa") @db.VarChar(10)
  nombre             String    @db.VarChar(100)
  idProvincia        Int       @map("id_provincia")
  descripcion        String?   @db.Text
  poblacionAprox     Int?      @map("poblacion_aprox")
  anioPoblacion      Int?      @map("anio_poblacion")
  fuenteInformacion  String?   @map("fuente_informacion") @db.VarChar(500)
  fechaActualizacion DateTime? @map("fecha_actualizacion") @db.Date
  latitud            Decimal?  @db.Decimal(9, 6)
  longitud           Decimal?  @db.Decimal(9, 6)
  imagenPortada      String?   @map("imagen_portada") @db.VarChar(2048)
  estado             Boolean   @default(true)

  provincia  Provincia   @relation(fields: [idProvincia], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parroquias Parroquia[]

  @@index([idProvincia], map: "canton_id_provincia_idx")
  @@map("canton")
}

model Parroquia {
  id                 Int       @id @default(autoincrement()) @map("id_parroquia")
  codigoDpa          String    @unique(map: "parroquia_codigo_dpa_key") @map("codigo_dpa") @db.VarChar(10)
  nombre             String    @db.VarChar(100)
  idCanton           Int       @map("id_canton")
  descripcion        String?   @db.Text
  poblacionAprox     Int?      @map("poblacion_aprox")
  anioPoblacion      Int?      @map("anio_poblacion")
  clima              String?   @db.VarChar(100)
  altitud            Int?
  latitud            Decimal?  @db.Decimal(9, 6)
  longitud           Decimal?  @db.Decimal(9, 6)
  imagenPortada      String?   @map("imagen_portada") @db.VarChar(2048)
  fuenteInformacion  String?   @map("fuente_informacion") @db.VarChar(500)
  fechaActualizacion DateTime? @map("fecha_actualizacion") @db.Date
  estado             Boolean   @default(true)

  canton   Canton   @relation(fields: [idCanton], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sectores Sector[]

  @@index([idCanton], map: "parroquia_id_canton_idx")
  @@map("parroquia")
}

model Sector {
  id          Int      @id @default(autoincrement()) @map("id_sector")
  idParroquia Int      @map("id_parroquia")
  nombre      String   @db.VarChar(150)
  tipoSector  String   @map("tipo_sector") @db.VarChar(30)
  descripcion String?  @db.Text
  latitud     Decimal? @db.Decimal(9, 6)
  longitud    Decimal? @db.Decimal(9, 6)
  estado      Boolean  @default(true)

  parroquia Parroquia @relation(fields: [idParroquia], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lugares   Lugar[]

  @@unique([idParroquia, nombre], map: "sector_parroquia_nombre_key")
  @@map("sector")
}

model Lugar {
  id                   Int      @id @default(autoincrement()) @map("id_lugar")
  idSector             Int      @map("id_sector")
  nombre               String   @db.VarChar(150)
  tipoLugar            String   @map("tipo_lugar") @db.VarChar(30)
  direccionReferencial String?  @map("direccion_referencial") @db.VarChar(255)
  referencia           String?  @db.Text
  latitud              Decimal? @db.Decimal(9, 6)
  longitud             Decimal? @db.Decimal(9, 6)
  estado               Boolean  @default(true)

  sector         Sector               @relation(fields: [idSector], references: [id], onDelete: Restrict, onUpdate: Cascade)
  eventos        Evento[]
  programaciones ProgramacionEvento[]

  @@unique([idSector, nombre], map: "lugar_sector_nombre_key")
  @@map("lugar")
}

model Rol {
  id          Int     @id @default(autoincrement()) @map("id_rol")
  nombre      String  @unique(map: "rol_nombre_key") @db.VarChar(50)
  descripcion String? @db.VarChar(255)
  estado      Boolean @default(true)

  usuarios Usuario[]

  @@map("rol")
}

model Usuario {
  id             Int      @id @default(autoincrement()) @map("id_usuario")
  idRol          Int      @map("id_rol")
  nombreCompleto String   @map("nombre_completo") @db.VarChar(150)
  correo         String   @unique(map: "usuario_correo_key") @db.VarChar(254)
  contrasenaHash String   @map("contrasena_hash") @db.VarChar(100)
  fechaRegistro  DateTime @default(now()) @map("fecha_registro") @db.Timestamp(3)
  estado         Boolean  @default(true)

  rol              Rol                     @relation(fields: [idRol], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens    RefreshToken[]
  eventosCreados   Evento[]                @relation("EventoCreador")
  eventosRevisados Evento[]                @relation("EventoRevisor")
  imagenesSubidas  ImagenEvento[]
  favoritos        UsuarioEventoFavorito[]
  recordatorios    Recordatorio[]

  @@index([idRol, estado], map: "usuario_rol_estado_idx")
  @@map("usuario")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique(map: "refresh_token_token_hash_key") @map("token_hash") @db.Char(64)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, revocadoEn, expiraEn], map: "refresh_token_usuario_estado_idx")
  @@map("refresh_token")
}

model Categoria {
  id          Int     @id @default(autoincrement()) @map("id_categoria")
  nombre      String  @unique(map: "categoria_nombre_key") @db.VarChar(100)
  descripcion String? @db.Text
  estado      Boolean @default(true)

  eventos EventoCategoria[]

  @@map("categoria")
}

model Evento {
  id                 Int       @id @default(autoincrement()) @map("id_evento")
  titulo             String    @db.VarChar(200)
  descripcion        String?   @db.Text
  fechaInicio        DateTime  @map("fecha_inicio") @db.Timestamp(3)
  fechaFin           DateTime? @map("fecha_fin") @db.Timestamp(3)
  costoReferencial   Decimal   @map("costo_referencial") @db.Decimal(10, 2)
  idLugar            Int       @map("id_lugar")
  idUsuarioCreador   Int       @map("id_usuario_creador")
  idUsuarioRevisor   Int?      @map("id_usuario_revisor")
  estadoEvento       String    @default("BORRADOR") @map("estado_evento") @db.VarChar(30)
  estadoRevision     String    @default("PENDIENTE") @map("estado_revision") @db.VarChar(30)
  fuenteInformacion  String?   @map("fuente_informacion") @db.VarChar(500)
  fechaCreacion      DateTime  @default(now()) @map("fecha_creacion") @db.Timestamp(3)
  fechaActualizacion DateTime? @map("fecha_actualizacion") @db.Timestamp(3)
  fechaRevision      DateTime? @map("fecha_revision") @db.Timestamp(3)

  lugar          Lugar                   @relation(fields: [idLugar], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioCreador Usuario                 @relation("EventoCreador", fields: [idUsuarioCreador], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuarioRevisor Usuario?                @relation("EventoRevisor", fields: [idUsuarioRevisor], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categorias     EventoCategoria[]
  programaciones ProgramacionEvento[]
  imagenes       ImagenEvento[]
  favoritos      UsuarioEventoFavorito[]
  recordatorios  Recordatorio[]

  @@index([idLugar], map: "evento_lugar_idx")
  @@index([idUsuarioCreador], map: "evento_creador_idx")
  @@index([idUsuarioRevisor], map: "evento_revisor_idx")
  @@index([estadoEvento, estadoRevision, fechaInicio], map: "evento_publicacion_fecha_idx")
  @@index([fechaInicio], map: "evento_fecha_inicio_idx")
  @@map("evento")
}

model EventoCategoria {
  idEvento    Int @map("id_evento")
  idCategoria Int @map("id_categoria")

  evento    Evento    @relation(fields: [idEvento], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoria Categoria @relation(fields: [idCategoria], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idEvento, idCategoria])
  @@index([idCategoria, idEvento], map: "evento_categoria_categoria_evento_idx")
  @@map("evento_categoria")
}

model ProgramacionEvento {
  id              Int       @id @default(autoincrement()) @map("id_programacion")
  idEvento        Int       @map("id_evento")
  idLugar         Int?      @map("id_lugar")
  tituloActividad String    @map("titulo_actividad") @db.VarChar(200)
  descripcion     String?   @db.Text
  fechaHoraInicio DateTime  @map("fecha_hora_inicio") @db.Timestamp(3)
  fechaHoraFin    DateTime? @map("fecha_hora_fin") @db.Timestamp(3)
  artistaInvitado String?   @map("artista_invitado") @db.VarChar(200)
  orden           Int?
  estado          Boolean   @default(true)

  evento        Evento         @relation(fields: [idEvento], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lugar         Lugar?         @relation(fields: [idLugar], references: [id], onDelete: Restrict, onUpdate: Cascade)
  imagenes      ImagenEvento[]
  recordatorios Recordatorio[]

  @@unique([idEvento, id], map: "programacion_evento_evento_programacion_key")
  @@index([idEvento, estado, fechaHoraInicio], map: "programacion_evento_evento_estado_inicio_idx")
  @@index([idLugar], map: "programacion_evento_lugar_idx")
  @@map("programacion_evento")
}

model ImagenEvento {
  id              Int      @id @default(autoincrement()) @map("id_imagen")
  idEvento        Int      @map("id_evento")
  idProgramacion  Int?     @map("id_programacion")
  idUsuarioSubida Int      @map("id_usuario_subida")
  urlImagen       String   @map("url_imagen") @db.VarChar(2048)
  tipoImagen      String   @map("tipo_imagen") @db.VarChar(30)
  descripcion     String?  @db.VarChar(255)
  esPrincipal     Boolean  @default(false) @map("es_principal")
  fechaSubida     DateTime @default(now()) @map("fecha_subida") @db.Timestamp(3)
  estado          Boolean  @default(true)

  evento        Evento              @relation(fields: [idEvento], references: [id], onDelete: Restrict, onUpdate: Cascade)
  programacion  ProgramacionEvento? @relation(fields: [idEvento, idProgramacion], references: [idEvento, id], onDelete: Restrict, onUpdate: Cascade)
  usuarioSubida Usuario             @relation(fields: [idUsuarioSubida], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([idEvento, estado], map: "imagen_evento_evento_estado_idx")
  @@index([idEvento, idProgramacion], map: "imagen_evento_evento_programacion_idx")
  @@map("imagen_evento")
}

model Recordatorio {
  id                Int      @id @default(autoincrement()) @map("id_recordatorio")
  idUsuario         Int      @map("id_usuario")
  idEvento          Int      @map("id_evento")
  idProgramacion    Int?     @map("id_programacion")
  fechaNotificacion DateTime @map("fecha_notificacion") @db.Timestamp(3)
  activo            Boolean  @default(true)
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamp(3)

  usuario      Usuario             @relation(fields: [idUsuario], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evento       Evento              @relation(fields: [idEvento], references: [id], onDelete: Restrict, onUpdate: Cascade)
  programacion ProgramacionEvento? @relation(fields: [idEvento, idProgramacion], references: [idEvento, id], onDelete: Restrict, onUpdate: Cascade)

  @@index([idUsuario, activo, fechaNotificacion], map: "recordatorio_usuario_activo_fecha_idx")
  @@index([idEvento, idProgramacion], map: "recordatorio_evento_programacion_idx")
  @@map("recordatorio")
}

model UsuarioEventoFavorito {
  idUsuario     Int      @map("id_usuario")
  idEvento      Int      @map("id_evento")
  fechaAgregado DateTime @default(now()) @map("fecha_agregado") @db.Timestamp(3)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade, onUpdate: Cascade)
  evento  Evento  @relation(fields: [idEvento], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([idUsuario, idEvento])
  @@index([idEvento, idUsuario], map: "usuario_evento_favorito_evento_usuario_idx")
  @@map("usuario_evento_favorito")
}
