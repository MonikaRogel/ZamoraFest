<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Identidad nativa ZamoraFest -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#061714</item>
        <item name="android:navigationBarColor">#061714</item>
        <item name="android:navigationBarDividerColor">#061714</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style
        name="AppTheme.NoActionBar"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- Barras del sistema fijas a la identidad ZamoraFest -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#061714</item>
        <item name="android:navigationBarColor">#061714</item>
        <item name="android:navigationBarDividerColor">#061714</item>

        <!-- false = iconos claros sobre fondo oscuro -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Android 10+ no debe imponer fondo claro -->
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style
        name="AppTheme.NoActionBarLaunch"
        parent="Theme.SplashScreen">

        <item name="android:background">@drawable/splash</item>

        <!-- Mantener continuidad visual durante el arranque -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#061714</item>
        <item name="android:navigationBarColor">#061714</item>
        <item name="android:navigationBarDividerColor">#061714</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

</resources>